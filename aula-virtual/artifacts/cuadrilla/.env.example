# Copia este archivo como .env (en esta carpeta). Las variables del sistema tienen prioridad.

# --- IA (LangChain) -------------------------------------------------------------------------
# Valor inicial: openai, vertex o gemini (API directa heredada).
# Administración → IA y modelos guarda la selección posterior en PostgreSQL.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Vertex AI usa ADC/cuenta de servicio; no necesita GOOGLE_API_KEY.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite
# Modelo; vacío usa el del proveedor (gpt-6-luna / gemini-3.5-flash).
LLM_MODEL=
# Esfuerzo de razonamiento (minimal, low, medium, high); vacío para no enviarlo.
LLM_REASONING_EFFORT=low
# Transcripción de videos y audios: por defecto el mismo proveedor.
# Modelos por defecto: gpt-4o-mini-transcribe (OpenAI) o gemini-3.5-flash (Gemini).
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=

# --- Base de datos ------------------------------------------------------------------------
# Vacío: PostgreSQL embebida en .local/postgres (requiere Python 3.11 o 3.12, como instala `uv sync`).
# Con servidor propio: postgresql://usuario:clave@localhost:5432/cuadrilla
DATABASE_URL=
# Crear al arrancar las tablas que falten (nunca modifica ni borra tablas existentes).
DB_AUTO_CREATE=true

# --- Servidor -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Prefijo si la app vive bajo una ruta, por ejemplo /cuadrilla.
BASE_PATH=/
# IPs de un proxy inverso de confianza (cabeceras X-Forwarded-*).
FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_HOURS=12
MAX_UPLOAD_MB=300

# --- Cuentas ------------------------------------------------------------------------------
# Modo demo: cuentas ficticias, malla de ejemplo y botón «Cargar datos de demostración».
DEMO_MODE=true
# Contraseña de las cuentas demo; vacío usa «cuadrilla» (la pantalla de ingreso lo advierte).
DEMO_PASSWORD=
# Primer administrador: se crea al arrancar si no existe un usuario con ese DNI.
ADMIN_DNI=
ADMIN_PASSWORD=
